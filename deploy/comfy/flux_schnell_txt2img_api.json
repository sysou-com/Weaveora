{
  "_comment": "Weaveora · FLUX.1-schnell 文生图（ComfyUI API 格式，GPU#2）。T2 档：速度快、许可干净（Apache-2.0）。worker 注入 4.text / 5 尺寸 / 6.seed。schnell 无负向（cfg=1.0）。",
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "unet" },
    "inputs": { "unet_name": "flux1-schnell-fp8.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "DualCLIPLoader",
    "_meta": { "title": "clip" },
    "inputs": {
      "clip_name1": "t5xxl_fp8_e4m3fn.safetensors",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "vae" },
    "inputs": { "vae_name": "ae.safetensors" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "positive" },
    "inputs": { "clip": ["2", 0], "text": "" }
  },
  "5": {
    "class_type": "EmptySD3LatentImage",
    "_meta": { "title": "latent" },
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "6": {
    "class_type": "KSampler",
    "_meta": { "title": "sampler" },
    "inputs": {
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["4", 0],
      "latent_image": ["5", 0],
      "seed": 0,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "7": {
    "class_type": "VAEDecode",
    "_meta": { "title": "decode" },
    "inputs": { "samples": ["6", 0], "vae": ["3", 0] }
  },
  "8": {
    "class_type": "SaveImage",
    "_meta": { "title": "save" },
    "inputs": { "images": ["7", 0], "filename_prefix": "weaveora_flux" }
  }
}
