{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weaveora.studio/schemas/director.schema.json",
  "title": "Weaveora DirectorPlan",
  "description": "导演层输出方案（§10.2）。前后端共享契约：studio.weaveora.director 落库 prompt_revisions.schema_json 的完整结构。字段稳定，新增字段向后兼容。",
  "type": "object",
  "required": ["mode", "title", "logline"],
  "properties": {
    "mode": { "enum": ["image", "video"] },
    "title": { "type": "string", "maxLength": 120 },
    "logline": { "type": "string", "maxLength": 300 },
    "prompt_zh": { "type": "string", "description": "中文解释（图片）" },
    "positive_prompt": { "type": "string", "description": "图片正向提示词（20–1200）" },
    "negative_prompt": { "type": "string", "description": "图片负向提示词" },
    "camera": {
      "type": "object",
      "properties": {
        "focal_mm": { "type": "number" },
        "shot_size": { "type": "string", "enum": ["extreme-wide", "wide", "medium", "close-up", "extreme-close-up"] },
        "angle": { "type": "string" },
        "viewpoint": { "type": "string", "description": "机位与主体关系：behind | from-front | over-shoulder | profile | three-quarter | top-down" },
        "foreground": { "type": "string", "description": "前景遮挡（如 the monk's back fills the foreground, softly blurred）" },
        "subject_axis": { "type": "string", "description": "主体朝向（如 the queen faces the camera / the monk's back to camera）" },
        "focus_subject": { "type": "string", "description": "对焦主体（如 the queen's face）" },
        "composition": { "type": "string", "description": "构图一句话（层次/遮挡/视线轴）" }
      }
    },
    "referenceAssets": {
      "type": "array",
      "description": "参考图↔主体绑定（参考图面板标注；region 为归一化 0–1 区域，用于 GPU 分区遮罩/IP-Adapter 解耦）",
      "items": {
        "type": "object",
        "required": ["assetId"],
        "properties": {
          "assetId": { "type": "string" },
          "subject": { "type": "string" },
          "region": {
            "type": "object",
            "properties": {
              "x": { "type": "number" }, "y": { "type": "number" },
              "w": { "type": "number" }, "h": { "type": "number" }
            }
          }
        }
      }
    },
    "lighting": { "type": "string" },
    "palette": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 5 },
    "params": {
      "type": "object",
      "properties": {
        "width": { "type": "integer", "multipleOf": 8 },
        "height": { "type": "integer", "multipleOf": 8 },
        "steps": { "type": "integer" },
        "cfg": { "type": "number" },
        "sampler": { "type": "string" },
        "seed": { "type": ["integer", "null"] }
      }
    },
    "variations": { "type": "array", "items": { "type": "object" } },
    "duration_sec": { "type": "number", "description": "视频目标时长（视频必填）" },
    "aspect_ratio": { "type": "string", "enum": ["1:1", "3:2", "2:3", "16:9", "9:16"] },
    "script": {
      "type": "object",
      "properties": {
        "theme": { "type": "string" },
        "acts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "start_sec": { "type": "number" },
              "end_sec": { "type": "number" },
              "purpose": { "type": "string" }
            }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "description": "视频镜头表：时长总和 == duration_sec ±0.5；数量 ≤ ceil(duration_sec/1.5)；单镜 positive_prompt 20–1200",
      "items": {
        "type": "object",
        "required": ["shot_no", "duration_sec", "positive_prompt", "negative_prompt"],
        "properties": {
          "shot_no": { "type": "integer" },
          "duration_sec": { "type": "number", "minimum": 1 },
          "shot_size": { "type": "string" },
          "camera_move": { "type": "string" },
          "action": { "type": "string" },
          "positive_prompt": { "type": "string", "minLength": 20, "maxLength": 1200 },
          "negative_prompt": { "type": "string" },
          "seed_lock": { "type": "boolean", "default": true },
          "ref_shot_no": { "type": ["integer", "null"] },
          "keyframes": {
            "type": "array",
            "description": "运镜关键帧（穿越/从A穿过看到B 类镜头）：2–4 帧；缺省则单帧（positive_prompt 即唯一帧）",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["positive_prompt"],
              "properties": {
                "label": { "type": "string", "description": "起始帧 / 中段 / 结束帧" },
                "t": { "type": ["number", "string"], "description": "该帧在镜内的时间点或语义标签" },
                "shot_size": { "type": "string" },
                "camera_move": { "type": "string" },
                "composition": { "type": "string", "description": "机位/遮挡/前景关系（如 behind monk, over-the-shoulder）" },
                "positive_prompt": { "type": "string", "minLength": 20, "maxLength": 1200 }
              }
            }
          },
          "narrations": {
            "type": "array",
            "description": "P8 镜内多段语音（旁白 + 角色台词）。存在时优先于 narration；缺省则把 narration 当作 [at_sec=0] 的单段（向后兼容）",
            "items": {
              "type": "object",
              "required": ["text"],
              "properties": {
                "at_sec": { "type": "number", "minimum": 0, "default": 0, "description": "该段在**镜内**的起始秒（相对镜头起点）" },
                "end_sec": { "type": "number", "minimum": 0, "description": "该段在镜内的结束秒（可选）。设了就按这个窗口裁切配音（超出部分剪掉），留空则用配音自然长度" },
                "text": { "type": "string", "minLength": 1 },
                "kind": {
                  "enum": ["narration", "dialogue"],
                  "description": "narration=旁白叙述；dialogue=角色台词。缺省：有 subject 则为 dialogue，否则 narration"
                },
                "subject": { "type": "string", "description": "说话人（角色/主体）。与 audio.voiceBindings[].subject 关联；旁白可留空" },
                "voice": { "type": "string", "description": "本段音色覆盖（优先于 voiceBindings 与 audio.voice）" },
                "speed": { "type": "number", "minimum": 0.5, "maximum": 2.0, "default": 1.0, "description": "本段语速" },
                "manual": { "type": "boolean", "description": "P10：位置/结束点被用户手动改过；自动铺排（避让、按实际时长对齐）只动非 manual 的段" }
              }
            }
          },
          "allowNarrationOverflow": {
            "type": "boolean",
            "description": "P10：该镜允许配音时长超出镜头（不再提醒）。不设时音频与字幕仍会自然溢到下一镜，但界面会告警"
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "music_mood": { "type": "string", "description": "整片默认配乐情绪；无 music 段时按它铺满全片（向后兼容）" },
        "voice": { "type": "string", "description": "默认配音音色：内置名（中文女/中文男/英文女/英文男/日语男/韩语女/粤语女）或参考音频路径（zero-shot 克隆）" },
        "voiceBindings": {
          "type": "array",
          "description": "P8 角色→音色绑定。解析优先级：narrations[].voice > voiceBindings[subject] > audio.voice > 默认",
          "items": {
            "type": "object",
            "required": ["subject", "voice"],
            "properties": {
              "subject": { "type": "string", "description": "角色/主体名（与 shots[].narrations[].subject、referenceAssets[].subject 同名即可自动关联）" },
              "voice": { "type": "string" },
              "speed": { "type": "number", "minimum": 0.5, "maximum": 2.0, "default": 1.0 }
            }
          }
        },
        "music": {
          "type": "array",
          "description": "P8 配乐段落表（可多段，支持起止/强弱/淡入淡出/循环）。存在时优先于 music_mood；同一 mood 只生成一次曲子，多段引用并各自套 gain/fade",
          "items": {
            "type": "object",
            "required": ["start_sec", "end_sec"],
            "properties": {
              "id": { "type": "string", "description": "段标识（导出与 UI 用；缺省按序号生成）" },
              "start_sec": { "type": "number", "minimum": 0, "description": "全片时间轴上的起始秒" },
              "end_sec": { "type": "number", "exclusiveMinimum": 0, "description": "全片时间轴上的结束秒（须 > start_sec）" },
              "mood": { "type": "string", "description": "该段配乐情绪；缺省用 audio.music_mood" },
              "gain_db": { "type": "number", "default": -10.5, "description": "音量（dB，0=原始，越低越轻）。默认 -10.5dB ≈ 线性 0.30（与 P7 行为一致）；‘一半’约 -16.5dB" },
              "fade_in_sec": { "type": "number", "minimum": 0, "default": 0 },
              "fade_out_sec": { "type": "number", "minimum": 0, "default": 0 },
              "loop": { "type": "boolean", "default": true, "description": "生成曲短于区间时循环填充" },
              "duck": { "type": "boolean", "default": true, "description": "是否被旁白/台词侧链压低（纯配乐段落可设 false）" }
            }
          }
        },
        "sfx": { "type": "array", "items": { "type": "string" } },
        "vo": { "type": "string" }
      }
    },
    "edit_plan": {
      "type": "object",
      "properties": {
        "fps": { "type": "integer" },
        "transition_default": { "type": "string" },
        "subtitle": { "type": "boolean" }
      }
    }
  }
}
