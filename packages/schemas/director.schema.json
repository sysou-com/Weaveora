{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weaveora.studio/schemas/director.schema.json",
  "title": "Weaveora DirectorPlan",
  "description": "导演层输出方案（§10.2）。前后端共享契约：studio.weaveora.director 落库 prompt_revisions.schema_json 的完整结构。字段稳定，新增字段向后兼容。",
  "type": "object",
  "required": ["mode", "title", "logline"],
  "properties": {
    "mode": { "enum": ["image", "video"] },
    "title": { "type": "string", "maxLength": 120 },
    "logline": { "type": "string", "maxLength": 300 },
    "prompt_zh": { "type": "string", "description": "中文解释（图片）" },
    "positive_prompt": { "type": "string", "description": "图片正向提示词（20–1200）" },
    "negative_prompt": { "type": "string", "description": "图片负向提示词" },
    "camera": {
      "type": "object",
      "properties": {
        "focal_mm": { "type": "number" },
        "shot_size": { "type": "string", "enum": ["extreme-wide", "wide", "medium", "close-up", "extreme-close-up"] },
        "angle": { "type": "string" },
        "viewpoint": { "type": "string", "description": "机位与主体关系：behind | from-front | over-shoulder | profile | three-quarter | top-down" },
        "foreground": { "type": "string", "description": "前景遮挡（如 the monk's back fills the foreground, softly blurred）" },
        "subject_axis": { "type": "string", "description": "主体朝向（如 the queen faces the camera / the monk's back to camera）" },
        "focus_subject": { "type": "string", "description": "对焦主体（如 the queen's face）" },
        "composition": { "type": "string", "description": "构图一句话（层次/遮挡/视线轴）" }
      }
    },
    "referenceAssets": {
      "type": "array",
      "description": "参考图↔主体绑定（参考图面板标注；region 为归一化 0–1 区域，用于 GPU 分区遮罩/IP-Adapter 解耦）",
      "items": {
        "type": "object",
        "required": ["assetId"],
        "properties": {
          "assetId": { "type": "string" },
          "subject": { "type": "string" },
          "region": {
            "type": "object",
            "properties": {
              "x": { "type": "number" }, "y": { "type": "number" },
              "w": { "type": "number" }, "h": { "type": "number" }
            }
          }
        }
      }
    },
    "lighting": { "type": "string" },
    "palette": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 5 },
    "params": {
      "type": "object",
      "properties": {
        "width": { "type": "integer", "multipleOf": 8 },
        "height": { "type": "integer", "multipleOf": 8 },
        "steps": { "type": "integer" },
        "cfg": { "type": "number" },
        "sampler": { "type": "string" },
        "seed": { "type": ["integer", "null"] }
      }
    },
    "variations": { "type": "array", "items": { "type": "object" } },
    "duration_sec": { "type": "number", "description": "视频目标时长（视频必填）" },
    "aspect_ratio": { "type": "string", "enum": ["1:1", "3:2", "2:3", "16:9", "9:16"] },
    "script": {
      "type": "object",
      "properties": {
        "theme": { "type": "string" },
        "acts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "start_sec": { "type": "number" },
              "end_sec": { "type": "number" },
              "purpose": { "type": "string" }
            }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "description": "视频镜头表：时长总和 == duration_sec ±0.5；数量 ≤ ceil(duration_sec/1.5)；单镜 positive_prompt 20–1200",
      "items": {
        "type": "object",
        "required": ["shot_no", "duration_sec", "positive_prompt", "negative_prompt"],
        "properties": {
          "shot_no": { "type": "integer" },
          "duration_sec": { "type": "number", "minimum": 1 },
          "shot_size": { "type": "string" },
          "camera_move": { "type": "string" },
          "action": { "type": "string" },
          "positive_prompt": { "type": "string", "minLength": 20, "maxLength": 1200 },
          "negative_prompt": { "type": "string" },
          "seed_lock": { "type": "boolean", "default": true },
          "ref_shot_no": { "type": ["integer", "null"] },
          "keyframes": {
            "type": "array",
            "description": "运镜关键帧（穿越/从A穿过看到B 类镜头）：2–4 帧；缺省则单帧（positive_prompt 即唯一帧）",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["positive_prompt"],
              "properties": {
                "label": { "type": "string", "description": "起始帧 / 中段 / 结束帧" },
                "t": { "type": ["number", "string"], "description": "该帧在镜内的时间点或语义标签" },
                "shot_size": { "type": "string" },
                "camera_move": { "type": "string" },
                "composition": { "type": "string", "description": "机位/遮挡/前景关系（如 behind monk, over-the-shoulder）" },
                "positive_prompt": { "type": "string", "minLength": 20, "maxLength": 1200 }
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "music_mood": { "type": "string" },
        "sfx": { "type": "array", "items": { "type": "string" } },
        "vo": { "type": "string" }
      }
    },
    "edit_plan": {
      "type": "object",
      "properties": {
        "fps": { "type": "integer" },
        "transition_default": { "type": "string" },
        "subtitle": { "type": "boolean" }
      }
    }
  }
}
